{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.2,
          0.6,
          1
        ]
      }
    },
    "shadow": {
      "light": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0,
            0,
            0
          ],
          "alpha": 0.2
        }
      },
      "base": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0,
            0,
            0
          ],
          "alpha": 0.3
        }
      },
      "strong": {
        "$value": {
          "colorSpace": "srgb",
          "components": [
            0,
            0,
            0
          ],
          "alpha": 0.4
        }
      }
    }
  },
  "dimension": {
    "spacing-small": {
      "$type": "dimension",
      "$value": {
        "value": 4,
        "unit": "px"
      }
    },
    "spacing-large": {
      "$type": "dimension",
      "$value": {
        "value": 1.5,
        "unit": "rem"
      }
    }
  },
  "number": {
    "line-height-base": {
      "$type": "number",
      "$value": 1.4
    }
  },
  "duration": {
    "fast": {
      "$type": "duration",
      "$value": {
        "value": 150,
        "unit": "ms"
      }
    },
    "slow": {
      "$type": "duration",
      "$value": {
        "value": 1.2,
        "unit": "s"
      }
    }
  },
  "cubic": {
    "ease-in": {
      "$type": "cubicBezier",
      "$value": [
        0.4,
        0,
        1,
        1
      ]
    }
  },
  "font": {
    "family": {
      "base": {
        "$type": "fontFamily",
        "$value": [
          "Roboto",
          "Arial",
          "sans-serif"
        ]
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "bold": {
        "$type": "fontWeight",
        "$value": "bold"
      }
    }
  },
  "stroke": {
    "dashed": {
      "$type": "strokeStyle",
      "$value": "dashed"
    }
  },
  "border": {
    "default": {
      "$type": "border",
      "$value": {
        "color": "{color.primary}",
        "width": {
          "value": 1,
          "unit": "px"
        },
        "style": "solid"
      }
    }
  },
  "typography": {
    "heading": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.base}",
        "fontSize": {
          "value": 24,
          "unit": "px"
        },
        "fontWeight": "{font.weight.bold}",
        "letterSpacing": {
          "value": 0.5,
          "unit": "px"
        },
        "lineHeight": 1.2
      }
    }
  },
  "gradient": {
    "primary": {
      "$type": "gradient",
      "$value": [
        {
          "color": {
            "colorSpace": "srgb",
            "components": [
              0,
              0,
              1
            ]
          },
          "position": 0
        },
        {
          "color": {
            "colorSpace": "srgb",
            "components": [
              1,
              0,
              0
            ]
          },
          "position": 1
        }
      ]
    }
  },
  "transition": {
    "default": {
      "$type": "transition",
      "$value": {
        "duration": "{duration.fast}",
        "delay": {
          "value": 0,
          "unit": "ms"
        },
        "timingFunction": "{cubic.ease-in}"
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "small": {
      "$value": {
        "color": "{color.shadow.light}",
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 1,
          "unit": "px"
        },
        "blur": {
          "value": 3,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "medium": {
      "$value": {
        "color": "{color.shadow.base}",
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 4,
          "unit": "px"
        },
        "blur": {
          "value": 8,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    },
    "large": {
      "$value": {
        "color": "{color.shadow.strong}",
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 8,
          "unit": "px"
        },
        "blur": {
          "value": 16,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        }
      }
    }
  }
}